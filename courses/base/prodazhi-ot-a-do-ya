}
likeBtn.addEventListener('click',()=>{
const liked=likeBtn.classList.toggle('liked');
localStorage.setItem(likeKey,liked?'1':'0');
});
doneBtn.addEventListener('click',()=>{
doneBtn.classList.toggle('done');
const isDone=doneBtn.classList.contains('done');
localStorage.setItem(doneKey,isDone?'1':'0');
document.querySelector('.stop[data-stop="'+num+'"]').classList.toggle('done',isDone);
document.querySelector('.rl-item[data-stop="'+num+'"]').classList.toggle('done',isDone);
updateProgress();
});
});

// Прогресс маршрута
function updateProgress(){
const done=document.querySelectorAll('.module-view .ma-done.done').length;
document.getElementById('rp-count').textContent=done;
const percent=Math.round(done/totalStops*100);
document.getElementById('rp-fill').style.width=percent+'%';
document.getElementById('route-progress').style.width=percent+'%';
}
updateProgress();

// Чек-листы
document.querySelectorAll('.checklist input[type="checkbox"]').forEach((cb,i)=>{
const key='atoz_sales_check_'+i;
if(localStorage.getItem(key)==='1')cb.checked=true;
cb.addEventListener('change',()=>{localStorage.setItem(key,cb.checked?'1':'0');});
});
</script>

</body>
</html>
